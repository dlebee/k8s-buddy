<!--
  Windows installer for k8s-buddy (WiX v5). Built by packaging/windows/build-msi.ps1.
  UpgradeCode must never change: it is how newer MSIs find and replace older installs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="k8s-buddy" Manufacturer="David Lebee" Version="$(var.Version)"
           UpgradeCode="07AB1409-7B7A-4443-A752-061DDA6A3C68" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of k8s-buddy is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/dlebee/k8s-buddy" />
    <Property Id="ARPHELPLINK" Value="https://github.com/dlebee/k8s-buddy/issues" />
    <Property Id="ARPNOMODIFY" Value="0" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="k8s-buddy">
        <!-- One file per component: the Go exe has no version resource, so WiX can't group them. -->
        <Component Id="AppExe">
          <File Id="AppExe" Source="$(var.BinDir)\k8s-buddy.exe" KeyPath="yes" />
        </Component>
        <Component Id="LicenseFile">
          <File Id="License" Source="$(var.BinDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="NoticeFile">
          <File Id="Notice" Source="$(var.BinDir)\NOTICE" Name="NOTICE.txt" KeyPath="yes" />
        </Component>
        <Component Id="StartAtLogin">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="k8s-buddy"
                         Type="string" Value="&quot;[INSTALLFOLDER]k8s-buddy.exe&quot;" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="k8s-buddy" Description="Watch your Kubernetes clusters"
                  Target="[INSTALLFOLDER]k8s-buddy.exe" Arguments="--open" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\k8s-buddy" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="k8s-buddy" Description="The k8s-buddy app and its Start menu shortcut." Level="1" AllowAbsent="no">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="NoticeFile" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="Autostart" Title="Start at login" Level="1"
             Description="Keep watching your clusters in the background after you sign in.">
      <ComponentRef Id="StartAtLogin" />
    </Feature>

    <!-- Launch after install so the dashboard opens straight away. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]k8s-buddy.exe&quot; --open"
                  Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 5" />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>
</Wix>
